{
  "name": "dawn-custom-build",
  "private": true,
  "scripts": {
    "build:css": "sass src/scss/custom.scss assets/custom.css --style=compressed --no-source-map",
    "build:js": "esbuild src/js/custom.js --bundle --minify --outfile=assets/custom.js",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "sass --watch src/scss/custom.scss:assets/custom.css",
    "watch:js": "esbuild src/js/custom.js --bundle --outfile=assets/custom.js --watch",
    "dev": "concurrently \"npm run watch:css\" \"npm run watch:js\" \"shopify theme dev\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "esbuild": "^0.23.0",
    "sass": "^1.77.0"
  },
  "dependencies": {
    "jquery": "^4.0.0",
    "slick-carousel": "^1.8.1"
  }
}
