{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="shop-by-category color-{{ section.settings.color_scheme }} gradient">
  <div
    class="shop-by-category__inner page-width section-{{ section.id }}-padding"
    data-shop-by-category
    data-slides-desktop="{{ section.settings.slides_desktop }}"
    data-slides-tablet="{{ section.settings.slides_tablet }}"
    data-slides-mobile="{{ section.settings.slides_mobile }}"
    data-peek="{{ section.settings.show_peek }}"
    data-autoplay="{{ section.settings.autoplay }}"
    data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  >
    <div class="shop-by-category__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="shop-by-category__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.show_arrows and section.blocks.size > 1 -%}
        <div class="shop-by-category__arrows">
          <button
            type="button"
            class="shop-by-category__arrow shop-by-category__arrow--prev"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
          <button
            type="button"
            class="shop-by-category__arrow shop-by-category__arrow--next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
        </div>
      {%- endif -%}
    </div>

    <div class="shop-by-category__slider">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign image = block.settings.image | default: collection.featured_image
          assign title = block.settings.title | default: collection.title
          assign link = block.settings.link | default: collection.url
        -%}
        <div class="shop-by-category__slide" {{ block.shopify_attributes }}>
          {%- if link != blank -%}
            <a href="{{ link }}" class="shop-by-category__card">
          {%- else -%}
            <div class="shop-by-category__card">
          {%- endif -%}

          <div class="shop-by-category__media shop-by-category__media--{{ section.settings.image_ratio }}">
            {%- if image != blank -%}
              {{
                image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 450, 600, 800, 1000',
                  sizes: '(min-width: 990px) 20vw, (min-width: 750px) 33vw, 50vw',
                  alt: title
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>

          {%- if title != blank -%}
            <p class="shop-by-category__title">{{ title | escape }}</p>
          {%- endif -%}

          {%- if link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop by category",
  "tag": "section",
  "class": "section section-shop-by-category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "shop by category"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "label": "Slides per view on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "slides_tablet",
      "label": "Slides per view on tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "label": "Slides per view on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_peek",
      "label": "Show part of the next slide",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "square"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Optional. Used for image, title and link when those are left empty."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category",
      "blocks": [
        { "type": "category", "settings": { "title": "SCRUB TOPS" } },
        { "type": "category", "settings": { "title": "SCRUB PANTS" } },
        { "type": "category", "settings": { "title": "SCRUB SETS" } },
        { "type": "category", "settings": { "title": "PRINTS" } },
        { "type": "category", "settings": { "title": "SCRUB JACKETS" } },
        { "type": "category", "settings": { "title": "LAB COATS" } }
      ]
    }
  ]
}
{% endschema %}
